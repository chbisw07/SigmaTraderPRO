APP_NAME=SigmaTraderPRO
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./.logs
AUDIT_CSV_DIR=./.audit
AUDIT_CSV_MAX_BYTES=10485760
JWT_SECRET_KEY=dev-insecure-change-me-please-use-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+psycopg://sigmatrader:sigmatrader@127.0.0.1:5432/sigmatraderpro
REDIS_URL=redis://127.0.0.1:6379/0

# Safety kill-switch for manual order dispatch (S4.3)
ORDERS_DISPATCH_ENABLED=true

# Broker secrets (dev-safe defaults; change for real use)
BROKER_ENCRYPTION_KEY=dev-broker-encryption-key-change-me

# Angel One SmartAPI connect headers (optional overrides)
ANGEL_HTTP_TIMEOUT_SECONDS=10
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_CLIENT_PUBLIC_IP=127.0.0.1
ANGEL_MAC_ADDRESS=00:00:00:00:00:00
ANGEL_INSTRUMENT_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
